{
  "manifest_version": 3,
  "name": "librezam-modified",
  "version": "1.2.0",
  "description": "Download current tab URL or last.fm tracks using native messaging",
  "data_collection_permissions": {
    "required": [
      "none"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "mdloader@dodecube",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "notifications",
    "storage",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "*://*.last.fm/*",
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_title": "Download Manager",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.last.fm/*",
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
