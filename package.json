{
  "name": "mdloader",
  "version": "1.2.0",
  "private": true,
  "description": "Firefox/Zen extension for downloading tracks via a local yt-dlp native host",
  "scripts": {
    "lint": "web-ext lint --source-dir extension --self-hosted --no-config-discovery",
    "start": "web-ext run --source-dir extension --no-config-discovery",
    "build": "web-ext build --source-dir extension --artifacts-dir artifacts --overwrite-dest --no-config-discovery",
    "sign": "web-ext sign --source-dir extension --artifacts-dir artifacts --channel unlisted --no-config-discovery"
  },
  "devDependencies": {
    "web-ext": "^8.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
